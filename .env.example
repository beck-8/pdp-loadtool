# FOC Chaintest Configuration

# Required: Your wallet private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Network: 'calibration' (testnet) or 'mainnet'
NETWORK=calibration

# Upload interval in seconds (default: 10)
UPLOAD_INTERVAL_SECONDS=10

# Number of operations before creating new dataset/payment rail (default: 10)
# Set to 0 to disable rotation
OPERATIONS_PER_ROTATION=10

# Data size in bytes (default: 1024 = 1KB, minimum: 127)
DATA_SIZE_BYTES=1024

# Enable CDN for faster retrieval (default: false)
WITH_CDN=false

# Total number of uploads to perform (default: 0 = unlimited)
MAX_UPLOADS=0
